default_platform(:android)

platform :android do

  desc "Build Flutter Android App Bundle"

  lane :build do

    workspace = ENV["WORKSPACE"] || "/workspace"

    sh("cd #{workspace}/app && flutter clean")
    sh("cd #{workspace}/app && flutter pub get")
    sh("cd #{workspace}/app && flutter pub run intl_utils:generate")
    sh("cd #{workspace}/app && flutter build appbundle --flavor=demo --dart-define=ENV=DEMO --release --verbose")

  end

end